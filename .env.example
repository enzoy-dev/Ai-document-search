# Required for protected upload/list/delete/search routes. Generate your own key.
API_KEY=

# Optional for startup; required only for generated answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# A compatible 384-dimensional SentenceTransformer model or a local model path.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional persistent model cache (uncomment to override).
# HF_HOME=.cache/huggingface

SIMILARITY_THRESHOLD=1.2
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads
DATA_DIR=data
