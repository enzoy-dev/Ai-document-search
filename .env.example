# Required for protected upload/list/delete/search routes. Generate your own key.
API_KEY=

# Optional for startup; required only for generated answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# A compatible 384-dimensional SentenceTransformer model or a local model path.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pin a model commit/revision for reproducible embeddings (optional).
EMBEDDING_REVISION=
# Optional persistent model cache (uncomment to override).
# HF_HOME=.cache/huggingface

SIMILARITY_THRESHOLD=1.2
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads
DATA_DIR=data

# Public read-only demonstration, isolated from the private collection.
DEMO_MODE=false
# Keep false for a demonstration without paid Gemini calls.
DEMO_ALLOW_GENERATION=false
# Shared limits per running instance, not per browser/user.
DEMO_REQUESTS_PER_MINUTE=20
DEMO_GENERATIONS_PER_DAY=20
